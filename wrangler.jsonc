{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bep-infra-tracker",
  "main": ".open-next/worker.js",
  // Pinned rather than floating: a compatibility date is the Workers runtime's
  // behaviour contract, and letting it drift means the deployed app can change
  // semantics without a code change.
  "compatibility_date": "2025-09-23",
  // nodejs_compat gives the Worker Node built-ins (crypto, buffer, streams)
  // that Next, Auth.js and bcryptjs all reach for.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Prisma's workerd client imports its query compiler as a WASM module. Workers
  // refuse to compile WASM from bytes at runtime, so it has to arrive as a module
  // the platform compiles ahead of time — which is what this rule declares.
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],

  // Secrets are NOT listed here — this file is committed. DATABASE_URL,
  // AUTH_SECRET and NEXT_PUBLIC_MAPBOX_TOKEN are set with `wrangler secret put`
  // and live only in Cloudflare.
  "vars": {
    "AUTH_TRUST_HOST": "true"
  }
}
