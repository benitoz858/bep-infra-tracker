{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bep-infra-tracker",
  "main": ".open-next/worker.js",
  // Pinned rather than floating: a compatibility date is the Workers runtime's
  // behaviour contract, and letting it drift means the deployed app can change
  // semantics without a code change.
  "compatibility_date": "2025-09-23",
  // nodejs_compat gives the Worker Node built-ins (crypto, buffer, streams)
  // that Next, Auth.js and bcryptjs all reach for.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Custom domain. `custom_domain: true` makes wrangler create and manage the
  // DNS record itself, which requires the zone to be in this Cloudflare account.
  "routes": [
    {
      "pattern": "tracker.bepresearch.com",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true
  },

  // Prisma's workerd client imports its query compiler as a WASM module. Workers
  // refuse to compile WASM from bytes at runtime, so it has to arrive as a module
  // the platform compiles ahead of time — which is what this rule declares.
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],

  // Secrets are NOT listed here — this file is committed. DATABASE_URL,
  // AUTH_SECRET and NEXT_PUBLIC_MAPBOX_TOKEN are set with `wrangler secret put`
  // and live only in Cloudflare.
  "vars": {
    // Which database driver src/lib/db.ts picks. Set explicitly rather than
    // sniffed: nodejs_compat installs unenv's `navigator` polyfill, so the
    // usual `navigator.userAgent === "Cloudflare-Workers"` check is not
    // trustworthy inside a Next bundle, and guessing wrong silently selects a
    // pooled TCP driver that a Worker cannot legally keep between requests.
    "RUNTIME": "workers",
    "AUTH_TRUST_HOST": "true",
    // Pinned to the canonical origin so sign-in redirects always land on the
    // custom domain, even when a request arrives via the workers.dev hostname.
    // This must stay unset in development — hardcoding it there sends redirects
    // to the wrong port.
    "AUTH_URL": "https://tracker.bepresearch.com"
  }
}
