// BEP AI Infrastructure Tracker — data model
//
// Design notes that are not obvious from the field names:
//
// * Money and capacity use Decimal, never Float. Float would silently lose
//   precision on multi-billion-dollar capex sums in the analytics rollups.
// * Project carries denormalised estimated*/confirmed* columns for fast table
//   and dashboard queries, while ProjectMetric holds the full evidence trail
//   (one row per claim, each with its own source and confidence). The columns
//   are the "current best answer"; ProjectMetric is "how we know".
// * Source has no DB-level unique on (projectId, url) because the spec allows an
//   explicit override for legitimately duplicated URLs. Uniqueness is enforced
//   in lib/services/sources.ts, which the override flag can bypass.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator clientWorkers {
  provider = "prisma-client"
  output   = "../src/generated/prisma-workers"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  revisions          ProjectRevision[]
  reviewedCandidates IngestionCandidate[]

  @@index([role])
}

// Auth.js adapter models. Present so an OAuth provider can be added later
// without a migration; the MVP authenticates with credentials only.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Companies
// ---------------------------------------------------------------------------

enum CompanyType {
  HYPERSCALER
  NEOCLOUD
  COLOCATION_PROVIDER
  GPU_VENDOR
  SERVER_VENDOR
  NETWORKING_VENDOR
  COOLING_VENDOR
  POWER_VENDOR
  UTILITY
  CONSTRUCTION
  REAL_ESTATE
  GOVERNMENT
  OTHER
}

model Company {
  id                  String      @id @default(cuid())
  name                String
  slug                String      @unique
  companyType         CompanyType
  ticker              String?
  website             String?
  headquartersCountry String?
  description         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  ownedProjects Project[]        @relation("ProjectOwner")
  projectLinks  ProjectCompany[]

  @@index([companyType])
  @@index([ticker])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum ProjectType {
  AI_FACTORY
  DATA_CENTER
  GPU_CLUSTER
  HYPERSCALE_CAMPUS
  COLOCATION
  SOVEREIGN_AI
  HPC
  POWER_PROJECT
  OTHER
}

enum ProjectStatus {
  RUMORED
  ANNOUNCED
  PLANNING
  PERMITTING
  UNDER_CONSTRUCTION
  PARTIALLY_OPERATIONAL
  OPERATIONAL
  DELAYED
  PAUSED
  CANCELLED
}

model Project {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  description    String?
  ownerCompanyId String?

  projectType ProjectType
  status      ProjectStatus

  city        String?
  stateRegion String?
  country     String
  latitude    Float?
  longitude   Float?

  announcementDate    DateTime?
  expectedOpeningDate DateTime?
  actualOpeningDate   DateTime?

  // Capacity: Decimal(12,3) supports sub-MW precision at any realistic scale.
  estimatedPowerMw  Decimal? @db.Decimal(12, 3)
  confirmedPowerMw  Decimal? @db.Decimal(12, 3)
  estimatedGpuCount Int?
  confirmedGpuCount Int?
  gpuModel          String?
  computePlatform   String?

  estimatedCapexUsd Decimal? @db.Decimal(18, 2)
  confirmedCapexUsd Decimal? @db.Decimal(18, 2)

  squareFeet        Int?
  coolingTechnology String?
  powerSource       String?
  utilityProvider   String?

  confidenceScore Int?
  analystNotes    String?
  lastVerifiedAt  DateTime?

  /// Grid operator and interconnection queue position. Restrictions bite
  /// through the queue, so this is how exposure is actually grouped.
  gridRegion GridRegion?
  queueZone  String?

  // Every seeded row carries this flag so demo figures can never be mistaken
  // for researched ones anywhere in the UI or in an export.
  isDemoData Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerCompany Company?          @relation("ProjectOwner", fields: [ownerCompanyId], references: [id], onDelete: SetNull)
  companies    ProjectCompany[]
  sources      Source[]
  metrics      ProjectMetric[]
  revisions    ProjectRevision[]
  tags         Tag[]             @relation("ProjectTags")

  ingestionCandidates IngestionCandidate[] @relation("SuggestedProject")
  restrictions        ProjectRestriction[]

  @@index([status])
  @@index([projectType])
  @@index([country])
  @@index([ownerCompanyId])
  @@index([lastVerifiedAt])
  @@index([expectedOpeningDate])
  @@index([name])
}

enum ProjectCompanyRole {
  OWNER
  OPERATOR
  DEVELOPER
  TENANT
  INVESTOR
  GPU_SUPPLIER
  SERVER_SUPPLIER
  NETWORKING_SUPPLIER
  COOLING_SUPPLIER
  POWER_EQUIPMENT_SUPPLIER
  UTILITY
  CONSTRUCTION_PARTNER
  LAND_OWNER
  OTHER
}

model ProjectCompany {
  id        String             @id @default(cuid())
  projectId String
  companyId String
  role      ProjectCompanyRole
  notes     String?
  createdAt DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([projectId, companyId, role])
  @@index([companyId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Evidence
// ---------------------------------------------------------------------------

enum SourceType {
  COMPANY_ANNOUNCEMENT
  SEC_FILING
  EARNINGS_CALL
  GOVERNMENT_FILING
  PERMIT
  UTILITY_FILING
  NEWS_ARTICLE
  INDUSTRY_REPORT
  CONFERENCE
  SOCIAL_MEDIA
  OTHER
}

model Source {
  id               String     @id @default(cuid())
  projectId        String
  title            String
  publisher        String?
  url              String
  publicationDate  DateTime?
  sourceType       SourceType
  excerpt          String?
  archivedUrl      String?
  reliabilityScore Int?
  isPrimarySource  Boolean    @default(false)
  accessedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metrics ProjectMetric[]

  @@index([projectId])
  @@index([sourceType])
  @@index([url])
}

enum MetricType {
  POWER_MW
  GPU_COUNT
  CAPEX_USD
  SQUARE_FEET
  RACK_COUNT
  LAND_ACRES
  PUE
  OPENING_DATE
  OTHER
}

enum ConfidenceLevel {
  CONFIRMED
  HIGH
  MEDIUM
  LOW
  ESTIMATED
}

model ProjectMetric {
  id           String     @id @default(cuid())
  projectId    String
  metricType   MetricType
  // Decimal(20,4) covers a PUE of 1.2345 and a capex of 500,000,000,000.00
  // in the same column without a precision branch per metric type.
  numericValue Decimal?   @db.Decimal(20, 4)
  textValue    String?
  unit         String?

  confidenceLevel ConfidenceLevel
  methodology     String?
  effectiveDate   DateTime?
  sourceId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([metricType])
  @@index([sourceId])
}

model ProjectRevision {
  id            String   @id @default(cuid())
  projectId     String
  userId        String?
  changeSummary String
  previousData  Json?
  newData       Json?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  projects Project[] @relation("ProjectTags")
}

// ---------------------------------------------------------------------------
// Agent ingestion (staging)
//
// Automated watchers write here, never into Project/Source/ProjectMetric. The
// reason is the whole editorial premise of the product: a figure is only worth
// citing because a human read the source and said so. If a crawler could write
// straight into confirmedPowerMw, the dashboard totals would move on unreviewed
// machine output and the confidence levels would stop meaning anything.
//
// A candidate is promoted by lib/services/ingestion.ts, which calls the same
// sources service the manual inbox uses — so URL-uniqueness, the
// confirmed-needs-a-source rule and revision writing all still apply on accept.
// ---------------------------------------------------------------------------

enum IngestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  /// Superseded because the same URL was already cited on the target project.
  DUPLICATE
}

enum IngestionRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model IngestionRun {
  id         String             @id @default(cuid())
  /// Watcher key, e.g. "rss:microsoft-newsroom".
  watcher    String
  status     IngestionRunStatus @default(RUNNING)
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  /// Items the watcher saw, before dedup.
  itemsSeen  Int                @default(0)
  /// Candidates actually written (new to us).
  itemsNew   Int                @default(0)
  /// Populated when status is FAILED. A failed run must be visible, not silent:
  /// a watcher that quietly stops returning results looks identical to "no news".
  error      String?

  candidates IngestionCandidate[]

  @@index([watcher, startedAt])
  @@index([status])
}

model IngestionCandidate {
  id     String          @id @default(cuid())
  runId  String
  status IngestionStatus @default(PENDING)

  // --- the proposed source ---
  url             String
  title           String
  publisher       String?
  publicationDate DateTime?
  sourceType      SourceType @default(NEWS_ARTICLE)
  excerpt         String?

  /// Best guess at which project this concerns; null means the reviewer must
  /// pick one (or create the project first).
  suggestedProjectId String?
  /// 0-100. How confident the matcher is about suggestedProjectId — not about
  /// the claims themselves, which carry their own ConfidenceLevel.
  matchScore         Int?
  /// Why it matched, shown to the reviewer so the suggestion is auditable
  /// rather than an opaque nudge.
  matchReason        String?

  /// Proposed claims, shaped like candidateClaimSchema. Held as JSON rather
  /// than rows because nothing here is a fact yet — it is a suggestion awaiting
  /// judgement, and giving it a ProjectMetric row would imply otherwise.
  proposedClaims Json?

  /// Which extractor produced the claims ("none", "heuristic", "claude:<model>"),
  /// so a bad extractor's output can be found and re-reviewed later.
  extractor String @default("none")

  reviewedAt      DateTime?
  reviewedById    String?
  reviewNote      String?
  /// Set on accept, linking the candidate to what it became.
  createdSourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run              IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  suggestedProject Project?     @relation("SuggestedProject", fields: [suggestedProjectId], references: [id], onDelete: SetNull)
  reviewedBy       User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  /// The dedup key. A watcher re-run must not re-propose what it already
  /// proposed, so the same URL can only appear once across all runs.
  @@unique([url])
  @@index([status, createdAt])
  @@index([suggestedProjectId])
  @@index([runId])
}

// ---------------------------------------------------------------------------
// Siting risk
//
// The gap this closes: a tracker that counts ordinances tells you how many
// jurisdictions said something, not how much capacity is actually blocked. Two
// things make that answerable —
//
//  1. Bindingness is graded, not boolean. A six-month zoning pause pending a
//     study and a permanent prohibition are both called "moratorium" in the
//     press and are not remotely the same fact. See BindingLevel.
//  2. Restrictions attach to projects through an explicit join, never by
//     inferring from a location string. A wrong inference would silently move
//     the headline GW-at-risk number, which is the one figure this page exists
//     to produce.
//
// An expiring restriction is tracked as deliberately as a new one: it is the
// positive catalyst nobody publishes a list of.
// ---------------------------------------------------------------------------

/// Grid operator. Restrictions bite on projects through the interconnection
/// queue, so exposure is far more meaningful by RTO than by country.
enum GridRegion {
  PJM
  ERCOT
  MISO
  CAISO
  SPP
  NYISO
  ISONE
  WECC_NON_ISO
  SERC_NON_ISO
  CANADA
  EU_ENTSOE
  UK_NESO
  NORDIC
  JAPAN
  KOREA
  INDIA
  OTHER
}

enum JurisdictionLevel {
  CITY
  TOWN
  VILLAGE
  TOWNSHIP
  BOROUGH
  COUNTY
  STATE
  PROVINCE
  NATIONAL
  SPECIAL_DISTRICT
  TRIBAL
  UTILITY_TERRITORY
}

/// What the restriction actually stops. "Moratorium" alone is not specific
/// enough to reason about: a water-use cap and a rezoning freeze constrain
/// completely different projects.
enum RestrictionScope {
  NEW_CONSTRUCTION
  REZONING
  PERMIT_ISSUANCE
  UTILITY_INTERCONNECTION
  WATER_USE
  BEHIND_METER_GENERATION
  NOISE_OR_SETBACK
  TAX_ABATEMENT
  DISCLOSURE_ONLY
  OTHER
}

/// How hard the restriction actually binds. The whole point of the scale: most
/// trackers collapse all of this into one dot.
enum BindingLevel {
  /// 0 — a study, task force or advisory resolution. Binds nothing.
  ADVISORY
  /// 1 — proposed but not yet adopted.
  PROPOSED
  /// 2 — extra process: hearings, disclosure, review boards. Slows, not stops.
  PROCEDURAL
  /// 3 — conditional cap or threshold; some projects still proceed.
  CONDITIONAL
  /// 4 — time-limited prohibition with a defined end date.
  TEMPORARY_BAN
  /// 5 — indefinite or permanent prohibition.
  PERMANENT_BAN
}

enum RestrictionStatus {
  PROPOSED
  ACTIVE
  EXPIRED
  LIFTED
  REJECTED
  SUPERSEDED
}

model Restriction {
  id   String @id @default(cuid())
  slug String @unique

  /// Human name of the jurisdiction, e.g. "Loudoun County".
  jurisdiction String
  level        JurisdictionLevel
  stateRegion  String?
  country      String
  latitude     Float?
  longitude    Float?

  gridRegion GridRegion?

  scope        RestrictionScope
  bindingLevel BindingLevel
  status       RestrictionStatus

  title    String
  summary  String?
  /// Ordinance / bill number, so a reader can find the primary document.
  citation String?

  proposedDate DateTime?
  enactedDate  DateTime?
  /// Null with a TEMPORARY_BAN means the end date was never published — worth
  /// surfacing, not silently treating as indefinite.
  expiryDate   DateTime?
  liftedDate   DateTime?

  analystNotes    String?
  confidenceScore Int?
  lastVerifiedAt  DateTime?
  isDemoData      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectRestriction[]
  sources  RestrictionSource[]

  @@index([status])
  @@index([bindingLevel])
  @@index([country, stateRegion])
  @@index([gridRegion])
  @@index([expiryDate])
}

/// Evidence for a restriction.
///
/// A separate model rather than making Source polymorphic: Source.projectId is
/// non-null and every service, export and validation path depends on that. A
/// nullable foreign key there would weaken the guarantee that project evidence
/// always belongs to a project, to save one small table.
model RestrictionSource {
  id               String     @id @default(cuid())
  restrictionId    String
  title            String
  publisher        String?
  url              String
  publicationDate  DateTime?
  sourceType       SourceType
  excerpt          String?
  archivedUrl      String?
  reliabilityScore Int?
  isPrimarySource  Boolean    @default(false)
  accessedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  restriction Restriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)

  @@index([restrictionId])
}

/// How a restriction affects one project. Explicit, analyst-asserted — never
/// inferred from matching location strings.
enum RestrictionImpact {
  /// The project cannot proceed while this stands.
  BLOCKED
  /// Proceeding but delayed or made more expensive.
  DELAYED
  /// In the jurisdiction but exempt (grandfathered, pre-permitted).
  EXEMPT
  /// Same jurisdiction, effect not yet established.
  UNDER_REVIEW
}

model ProjectRestriction {
  id            String            @id @default(cuid())
  projectId     String
  restrictionId String
  impact        RestrictionImpact
  /// Capacity actually at risk, where it is less than the project's full size
  /// (e.g. only a later phase is blocked). Null means the whole project.
  affectedMw    Decimal?          @db.Decimal(12, 3)
  notes         String?
  createdAt     DateTime          @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  restriction Restriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)

  @@unique([projectId, restrictionId])
  @@index([restrictionId])
  @@index([projectId])
}
