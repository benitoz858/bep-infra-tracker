# Copy to .env and fill in. Everything below is what a local clone needs to run
# `npm run dev`, `npm run check` and `npm run test:e2e`.
#
# Nothing here is a real credential. The Postgres values match docker-compose.yml,
# so if you use `docker compose up -d` they work unchanged.

# --- Database ---------------------------------------------------------------

# Matches the container in docker-compose.yml. Prisma's ?schema parameter is
# required here; note that libpq-based tools (psql) reject it, which is why CI
# passes host and user as explicit flags instead.
DATABASE_URL="postgresql://bep:bep@localhost:5432/bep_infra_tracker?schema=public"

# The integration suite truncates tables between tests, so it must never point
# at the database you develop against. docker/init-test-db.sql creates this one
# on the container's first boot.
TEST_DATABASE_URL="postgresql://bep:bep@localhost:5432/bep_infra_tracker_test?schema=public"

# --- Auth -------------------------------------------------------------------

# Generate your own: openssl rand -base64 32
AUTH_SECRET=""

# Auth.js otherwise refuses to trust the forwarded host in development.
AUTH_TRUST_HOST="true"

# --- Seeded admin -----------------------------------------------------------

# `npm run db:seed` creates this account. Reading the tracker needs no account
# at all; you only need to sign in to exercise the write paths.
SEED_ADMIN_EMAIL="admin@bepresearch.com"
SEED_ADMIN_PASSWORD="bep-dev-admin"
SEED_ADMIN_NAME="BEP Admin"

# --- Map --------------------------------------------------------------------

# Optional. Without it the map page renders an explanatory placeholder rather
# than failing, so you can skip this unless you are working on the map. Use a
# public (pk.*) token — this one reaches the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- End-to-end tests -------------------------------------------------------

# Optional. Playwright starts the app on this port; only change it if 3320 is
# already taken on your machine.
# E2E_PORT="3320"

# --- Maintainers only -------------------------------------------------------

# Used by `npm run db:migrate:production` and `npm run db:seed:admin:production`.
# Contributors do not need these and should leave them unset — an accidental
# value here points a migration at production.
# PRODUCTION_DATABASE_URL=""
# PRODUCTION_ADMIN_PASSWORD=""
